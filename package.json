{
  "name": "hefe-herz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Click-&-Collect-Demo für die fiktive Bäckerei Hefe & Herz (Schulprojekt)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:artifact": "vite build -c vite.artifact.config.ts && node scripts/artifact.mjs",
    "build:pages": "tsc -b && VITE_ROUTER=hash vite build --base=./ --outDir docs --emptyOutDir && touch docs/.nojekyll"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.9"
  }
}
